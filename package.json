{
  "name": "costbase",
  "private": true,
  "version": "0.1.0",
  "description": "CostBase - Plataforma de Inteligência Histórica de Custos para Construção Civil",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace apps/backend run start:dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace apps/backend run build",
    "build:frontend": "npm --workspace apps/frontend run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npm --workspace apps/backend run prisma:generate",
    "prisma:migrate": "npm --workspace apps/backend run prisma:migrate",
    "prisma:deploy": "npm --workspace apps/backend run prisma:deploy",
    "prisma:studio": "npm --workspace apps/backend run prisma:studio",
    "seed": "npm --workspace apps/backend run seed",
    "lint": "npm --workspaces run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
